rules_version = '2';
// Deploy in Firebase Console → Firestore → Rules.
// Uses Anonymous Auth from the site; tighten further if you enable App Check.
service cloud.firestore {
  match /databases/{database}/documents {
    function ratingSmallDelta(oldV, newV) {
      return newV is int
        && oldV is int
        && newV >= 0
        && newV - oldV <= 1
        && newV - oldV >= -1;
    }

    function intDeltaAtMostOne(oldV, newV) {
      return newV is int
        && oldV is int
        && newV >= oldV
        && newV - oldV <= 1;
    }

    function statsRecentHourOk(oldStats, newStats) {
      return newStats.recentHourCount == oldStats.recentHourCount
        || (
          newStats.recentHourCount is int
          && newStats.recentHourCount >= 0
          && newStats.recentHourCount <= 8
          && (
            (
              (oldStats.lastSubmissionAt == null
                || oldStats.lastSubmissionAt < request.time - duration.value(1, 'h'))
              && newStats.recentHourCount == 1
            )
            || (
              !(oldStats.lastSubmissionAt == null
                || oldStats.lastSubmissionAt < request.time - duration.value(1, 'h'))
              && newStats.recentHourCount == oldStats.recentHourCount + 1
            )
          )
        );
    }

    function statsSelfCreateOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
              'uid', 'submissionsTotal', 'duplicatesAttempted', 'rejectedTotal',
              'submitBlocked', 'recentHourCount', 'lastSubmissionAt', 'updated'
            ])
        && d.uid == request.auth.uid
        && d.submissionsTotal is int
        && d.duplicatesAttempted is int
        && d.rejectedTotal is int
        && d.submissionsTotal >= 0
        && d.submissionsTotal <= 1
        && d.duplicatesAttempted >= 0
        && d.duplicatesAttempted <= 1
        && d.rejectedTotal == 0
        && d.submitBlocked == false
        && d.recentHourCount is int
        && d.recentHourCount >= 0
        && d.recentHourCount <= 1;
    }

    function statsSelfUpdateOk() {
      let d = request.resource.data;
      let r = resource.data;
      return d.keys().hasOnly([
              'uid', 'submissionsTotal', 'duplicatesAttempted', 'rejectedTotal',
              'submitBlocked', 'recentHourCount', 'lastSubmissionAt', 'updated'
            ])
        && d.uid == r.uid
        && d.uid == request.auth.uid
        && d.rejectedTotal == r.rejectedTotal
        && intDeltaAtMostOne(r.submissionsTotal, d.submissionsTotal)
        && intDeltaAtMostOne(r.duplicatesAttempted, d.duplicatesAttempted)
        && (d.submitBlocked == r.submitBlocked
            || (d.submitBlocked == true && r.submitBlocked == false))
        && statsRecentHourOk(r, d);
    }

    function validUrlKeyHash(hash) {
      return hash is string && hash.matches('^[a-f0-9]{64}$');
    }

    /** New folders set visibility + isPublic; legacy docs may only have isPublic. */
    function savedFolderPrivacyPairOk(d) {
      return (d.visibility is string
          && (d.visibility == 'public' || d.visibility == 'unlisted' || d.visibility == 'private')
          && d.isPublic is bool
          && d.isPublic == (d.visibility == 'public'))
        || (!(d.visibility is string) && d.isPublic is bool);
    }

    function isSignedInNonAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSubmissionAdmin() {
      return isSignedInNonAnonymous()
        && exists(/databases/$(database)/documents/config/submissions)
        && request.auth.uid in get(/databases/$(database)/documents/config/submissions).data.adminUids;
    }

    function notSubmissionBanned() {
      return !exists(/databases/$(database)/documents/contributorBans/$(request.auth.uid));
    }

    function statsNotSubmitBlocked() {
      return !exists(/databases/$(database)/documents/contributorStats/$(request.auth.uid))
        || !('submitBlocked' in get(/databases/$(database)/documents/contributorStats/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/contributorStats/$(request.auth.uid)).data.submitBlocked == false;
    }

    function validSubmissionUrl(u) {
      return u is string
        && u.size() >= 10
        && u.size() <= 2048
        && (u.matches('^https://.*') || u.matches('^http://.*'));
    }

    match /link_clicks/{docId} {
      allow read: if true;
      allow create: if isSignedInNonAnonymous()
        && validUrlKeyHash(docId)
        && request.resource.data.keys().hasOnly(['url', 'count', 'updated'])
        && request.resource.data.url is string
        && request.resource.data.url.size() >= 10
        && request.resource.data.url.size() <= 2048
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 1;
      allow update: if isSignedInNonAnonymous()
        && validUrlKeyHash(docId)
        && request.resource.data.keys().hasOnly(['url', 'count', 'updated'])
        && request.resource.data.url is string
        && request.resource.data.url.size() >= 10
        && request.resource.data.url.size() <= 2048
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 500000
        && ratingSmallDelta(resource.data.count, request.resource.data.count);
    }
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Lowercase username → uid (claim on create; only owner may update/delete).
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(["uid"])
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/usernames/$(uname))
            || get(/databases/$(database)/documents/usernames/$(uname)).data.uid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Shared saved-link folders: owner edits sync live to all readers (onSnapshot).
    // Anyone may read folders that are publicly listed OR unlisted by link (?folder=). Writes keep isPublic in sync so isPublic == true <=> visibility public / legacy public.
    // Firestore QUERY rules must line up with allow read predicates: listing uses where(isPublic == true); that proves isPublic matches the first clause below — required or permission-denied.
    // Private (isPublic false): only the signed-in non-anonymous owner may read unless visibility is still unlisted (link-only opens).
    match /savedFolders/{folderId} {
      allow read: if resource.data.isPublic == true
        || resource.data.visibility == 'unlisted'
        || (request.auth != null
            && request.auth.token.firebase.sign_in_provider != 'anonymous'
            && request.auth.uid == resource.data.ownerUid);
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.visibility is string
        && savedFolderPrivacyPairOk(request.resource.data)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3000
        && (!request.resource.data.keys().hasAny(['ownerLabel'])
            || (request.resource.data.ownerLabel is string
                && request.resource.data.ownerLabel.size() <= 120));
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && savedFolderPrivacyPairOk(request.resource.data)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3000
        && (!request.resource.data.keys().hasAny(['ownerLabel'])
            || (request.resource.data.ownerLabel is string
                && request.resource.data.ownerLabel.size() <= 120));
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.ownerUid == request.auth.uid;
    }

    // Community link thumbs (aggregate + one vote doc per signed-in user per link hash).
    match /linkRatings/{linkHash} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && linkHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['up', 'down', 'norm', 'updated'])
        && request.resource.data.up is int
        && request.resource.data.down is int
        && request.resource.data.up >= 0
        && request.resource.data.down >= 0
        && request.resource.data.norm is string
        && request.resource.data.norm.size() <= 2048
        && ((request.resource.data.up == 1 && request.resource.data.down == 0)
            || (request.resource.data.up == 0 && request.resource.data.down == 1));
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && linkHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['up', 'down', 'norm', 'updated'])
        && request.resource.data.up is int
        && request.resource.data.down is int
        && request.resource.data.up >= 0
        && request.resource.data.down >= 0
        && request.resource.data.up <= 500000
        && request.resource.data.down <= 500000
        && request.resource.data.norm is string
        && request.resource.data.norm.size() <= 2048
        && ratingSmallDelta(resource.data.up, request.resource.data.up)
        && ratingSmallDelta(resource.data.down, request.resource.data.down);
    }
    match /linkRatingVotes/{voteId} {
      allow get: if request.auth != null
        && voteId.matches('^' + request.auth.uid + '_[a-f0-9]{64}$');
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && voteId == request.auth.uid + '_' + request.resource.data.linkHash
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.linkHash is string
        && request.resource.data.linkHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.norm is string
        && request.resource.data.norm.size() <= 2048
        && request.resource.data.vote is int
        && (request.resource.data.vote == 1 || request.resource.data.vote == -1)
        && request.resource.data.keys().hasOnly(['uid', 'linkHash', 'norm', 'vote', 'updated']);
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + resource.data.linkHash;
    }

    // How many signed-in users currently have this normalized URL in their saved list (±1 per save/unsave).
    match /linkSaveCounts/{linkHash} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && linkHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['count', 'norm', 'updated'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 1
        && request.resource.data.norm is string
        && request.resource.data.norm.size() <= 2048;
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && linkHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['count', 'norm', 'updated'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 500000
        && request.resource.data.norm == resource.data.norm
        && ratingSmallDelta(resource.data.count, request.resource.data.count);
    }

    match /folderRatings/{folderId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && folderId.matches('^[a-zA-Z0-9_-]{1,700}$')
        && request.resource.data.keys().hasOnly(['up', 'down', 'updated'])
        && request.resource.data.up is int
        && request.resource.data.down is int
        && request.resource.data.up >= 0
        && request.resource.data.down >= 0
        && ((request.resource.data.up == 1 && request.resource.data.down == 0)
            || (request.resource.data.up == 0 && request.resource.data.down == 1));
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && folderId.matches('^[a-zA-Z0-9_-]{1,700}$')
        && request.resource.data.keys().hasOnly(['up', 'down', 'updated'])
        && request.resource.data.up is int
        && request.resource.data.down is int
        && request.resource.data.up >= 0
        && request.resource.data.down >= 0
        && request.resource.data.up <= 500000
        && request.resource.data.down <= 500000
        && ratingSmallDelta(resource.data.up, request.resource.data.up)
        && ratingSmallDelta(resource.data.down, request.resource.data.down);
    }
    match /folderRatingVotes/{voteId} {
      allow get: if request.auth != null
        && voteId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_-]{1,700}$');
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && voteId == request.auth.uid + '_' + request.resource.data.folderId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.folderId is string
        && request.resource.data.folderId.matches('^[a-zA-Z0-9_-]{1,700}$')
        && request.resource.data.vote is int
        && (request.resource.data.vote == 1 || request.resource.data.vote == -1)
        && request.resource.data.keys().hasOnly(['uid', 'folderId', 'vote', 'updated']);
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + resource.data.folderId;
    }

    // On-site link submissions (pending review). Admins review in docs/admin/submissions.html.
    match /config/submissions {
      allow read: if isSignedInNonAnonymous();
      allow write: if false;
    }

    match /linkSubmissions/{submissionId} {
      allow read: if isSubmissionAdmin()
        || (isSignedInNonAnonymous() && resource.data.submitterUid == request.auth.uid);
      allow create: if isSignedInNonAnonymous()
        && notSubmissionBanned()
        && statsNotSubmitBlocked()
        && request.resource.data.submitterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validSubmissionUrl(request.resource.data.url)
        && request.resource.data.urlKey is string
        && request.resource.data.urlKey.size() >= 10
        && request.resource.data.urlKey.size() <= 2048
        && validUrlKeyHash(request.resource.data.urlKeyHash)
        && exists(/databases/$(database)/documents/pendingSubmissionKeys/$(request.resource.data.urlKeyHash))
        && get(/databases/$(database)/documents/pendingSubmissionKeys/$(request.resource.data.urlKeyHash)).data.submitterUid == request.auth.uid
        && get(/databases/$(database)/documents/pendingSubmissionKeys/$(request.resource.data.urlKeyHash)).data.urlKey == request.resource.data.urlKey
        && request.resource.data.provider is string
        && request.resource.data.provider.size() > 0
        && request.resource.data.provider.size() <= 120
        && request.resource.data.isNewProvider is bool
        && request.resource.data.submitterLabel is string
        && request.resource.data.submitterLabel.size() > 0
        && request.resource.data.submitterLabel.size() <= 120
        && request.resource.data.submitterGithub is string
        && request.resource.data.submitterGithub.size() > 0
        && request.resource.data.submitterGithub.size() <= 39
        && request.resource.data.submitterGithub.matches('^[a-zA-Z0-9]([a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$')
        && (!request.resource.data.keys().hasAny(['optionalNote'])
            || (request.resource.data.optionalNote is string
                && request.resource.data.optionalNote.size() <= 500));
      allow update, delete: if isSubmissionAdmin();
    }

    // One pending row per normalized URL; doc id is SHA-256(urlKey).
    match /pendingSubmissionKeys/{urlKeyHash} {
      allow read: if isSignedInNonAnonymous();
      allow create: if isSignedInNonAnonymous()
        && notSubmissionBanned()
        && statsNotSubmitBlocked()
        && validUrlKeyHash(urlKeyHash)
        && !exists(/databases/$(database)/documents/pendingSubmissionKeys/$(urlKeyHash))
        && request.resource.data.keys().hasOnly(['urlKey', 'urlKeyHash', 'submitterUid', 'created'])
        && request.resource.data.urlKeyHash == urlKeyHash
        && request.resource.data.submitterUid == request.auth.uid
        && request.resource.data.urlKey is string
        && request.resource.data.urlKey.size() >= 10
        && request.resource.data.urlKey.size() <= 2048;
      allow delete: if isSubmissionAdmin();
    }

    match /contributorBans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSubmissionAdmin());
      allow create, update, delete: if isSubmissionAdmin();
    }

    match /contributorStats/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSubmissionAdmin());
      allow create: if isSubmissionAdmin()
        || (isSignedInNonAnonymous()
            && request.auth.uid == uid
            && statsSelfCreateOk());
      allow update: if isSubmissionAdmin()
        || (isSignedInNonAnonymous()
            && request.auth.uid == uid
            && statsSelfUpdateOk());
      allow delete: if false;
    }
  }
}
